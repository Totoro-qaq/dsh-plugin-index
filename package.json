{
  "name": "totoro-dsh-plugin-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "update": "node src/cli.mjs update",
    "check": "node src/cli.mjs check",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='src/*.mjs' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test test/*.test.mjs",
    "lint": "node --check src/index.mjs && node --check src/cli.mjs",
    "verify": "npm run lint && npm run test:coverage && npm run check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4"
  }
}
